# The only required API key. Needs Responses API + web_search access and API billing.
OPENAI_API_KEY=

# Documented models with web_search support; change if your account requires another.
OPENAI_MODEL=gpt-6.1-sol
# Used only when history exceeds the exact-context budget.
MEMORY_MODEL=gpt-6-luna

PORT=3000
# Optional. Browser supplies its IANA timezone on each request.
DEFAULT_TIMEZONE=UTC
# Optional. SQLite directory; defaults to ./data (never committed).
# DATA_DIR=./data
